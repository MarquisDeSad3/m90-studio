# Database (Postgres). For local dev: Neon free tier or local docker.
DATABASE_URL=postgres://user:password@localhost:5432/m90_studio

# Public site URL (no trailing slash). Used for OG, sitemap, canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: subpath deploy (leave empty unless serving under /something)
NEXT_PUBLIC_BASE_PATH=

# WhatsApp number M90 (without + or spaces, country code first).
NEXT_PUBLIC_WHATSAPP_NUMBER=5363285022

# Telegram bot para notificar al admin cuando entra un pedido. Setup:
#   1. Abrir Telegram, hablar con @BotFather
#   2. /newbot → seguir flow → da TOKEN
#   3. Hablar con el bot ("/start"), después visitar
#      https://api.telegram.org/bot<TOKEN>/getUpdates para ver chat_id
# Si están vacías, el sistema silenciosamente NO notifica (no rompe nada).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook (opcional) — si el bot tiene que RESPONDER cuando alguien le
# habla (ej. mensaje de bienvenida en /start), hace falta configurar el
# webhook a /api/telegram/webhook.
#
# Setup (una vez por deploy):
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     --data-urlencode "url=https://m90.studio/api/telegram/webhook" \
#     --data-urlencode "secret_token=<aqui un random largo>"
#
# El secret_token tiene que coincidir con TELEGRAM_WEBHOOK_SECRET. Si está
# vacío, el endpoint deja pasar todo (sin validar origen — solo dev).
TELEGRAM_WEBHOOK_SECRET=
